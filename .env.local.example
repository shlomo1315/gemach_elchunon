# העתק קובץ זה ל-.env.local (לפיתוח מקומי).
# ב-Railway: הוסף את המשתנים תחת Service → Variables.

# ===== מסד הנתונים (Railway Postgres) =====
# ב-Railway עדיף להפנות לשירות המסד במקום להעתיק ערך:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# לפיתוח מקומי מול המסד של Railway, השתמש ב-DATABASE_PUBLIC_URL מהדשבורד.
DATABASE_URL=postgresql://postgres:password@host:5432/railway

# ===== מפתח חתימת ה-sessions (חובה) =====
# בלי המפתח הזה אי אפשר להתחבר למערכת. אורך מינימלי: 32 תווים.
# ליצירת מפתח:  openssl rand -base64 32
AUTH_SECRET=

# ===== התראות מייל (Resend) — אופציונלי =====
# בלי המשתנים האלה המערכת עובדת רגיל, פשוט לא נשלחים מיילים.
# 1) נרשמים בחינם ב-https://resend.com ויוצרים API Key.
# 2) ADMIN_EMAIL = המייל שלך (המנהל) שיקבל התראה על כל פעולה.
# 3) EMAIL_FROM = כתובת השולח. לבדיקות אפשר להשתמש ב-onboarding@resend.dev,
#    ולכתובת אמיתית צריך לאמת דומיין ב-Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
ADMIN_EMAIL=manager@example.com
EMAIL_FROM=גמ"ח זכרון אהרן <onboarding@resend.dev>
