# העתק קובץ זה ל-.env.local (לפיתוח מקומי) והכנס את הערכים מ-Supabase
# ב-Vercel: הוסף את המשתנים האלה ב-Project Settings → Environment Variables

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ===== מערכת מיילים (Resend) — אופציונלי =====
# בלי המשתנים האלה המערכת עובדת רגיל, פשוט לא נשלחים מיילים.
# הוראות הקמה מלאות (אימות הדומיין gemach.shlomo4you.com): EMAIL_SETUP.md
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
ADMIN_EMAIL=manager@example.com
# כתובת השולח (ברירת מחדל אם לא מוגדר):
# EMAIL_FROM=גמ"ח זכרון אהרן <noreply@gemach.shlomo4you.com>

# --- חלופה: שליחה דרך Gmail (אם RESEND_API_KEY לא מוגדר) ---
# GMAIL_USER=gemach@gmail.com
# OAuth2: GMAIL_CLIENT_ID + GMAIL_CLIENT_SECRET + GMAIL_REFRESH_TOKEN
# או סיסמת אפליקציה (דורשת אימות דו-שלבי): GMAIL_APP_PASSWORD
