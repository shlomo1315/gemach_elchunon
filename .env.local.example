# העתק קובץ זה ל-.env.local (לפיתוח מקומי) והכנס את הערכים מ-Supabase
# ב-Vercel: הוסף את המשתנים האלה ב-Project Settings → Environment Variables

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ===== מערכת מיילים (Resend) — אופציונלי =====
# בלי המשתנים האלה המערכת עובדת רגיל, פשוט לא נשלחים מיילים.
# הוראות הקמה מלאות (אימות הדומיין ב-Cloudflare): EMAIL_SETUP.md
RESEND_API_KEY=re_xxxxxxxx
# לאן יגיעו התראות המנהל (חובה כשמשתמשים ב-Resend)
ADMIN_EMAIL=manager@example.com
# כתובת השולח. ברירת מחדל: גמ"ח זכרון אהרן <office@gemach.shlomo4you.com>
# EMAIL_FROM=גמ"ח זכרון אהרן <office@gemach.shlomo4you.com>

# --- גיבוי: Gmail (בשימוש רק אם RESEND_API_KEY לא מוגדר) ---
# GMAIL_USER=gemach@gmail.com
# GMAIL_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=GOCSPX-xxxxxxxx
# GMAIL_REFRESH_TOKEN=1//xxxxxxxx
# סיסמת אפליקציה במקום OAuth (דורשת אימות דו-שלבי): GMAIL_APP_PASSWORD=...
